<Window x:Class="PCLInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PCL-EDIT 安装程序"
        Width="760" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 卡片投影 -->
        <DropShadowEffect x:Key="CardShadow" Color="#8ba6c7" BlurRadius="34" ShadowDepth="6" Opacity="0.28" />
    </Window.Resources>

    <!-- 外层留白，用于放下阴影 -->
    <Grid Margin="22">
        <Border CornerRadius="14" Background="{StaticResource WindowBack}"
                BorderBrush="#e3edfb" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ============ 标题栏（可拖动） ============ -->
                <Grid x:Name="CaptionBar" Grid.Row="0" Height="52" Background="Transparent"
                      MouseLeftButtonDown="CaptionBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 小图标 -->
                    <Border Width="26" Height="26" CornerRadius="7" Margin="20,0,10,0" VerticalAlignment="Center"
                            Background="{StaticResource PrimaryGradient}">
                        <TextBlock Text="P" Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LabCaption" Text="PCL-EDIT 安装程序"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ColorBrush1}" />
                        <TextBlock x:Name="LabVersion" Text=" 3.0.0" FontSize="12.5"
                                   Foreground="{StaticResource Gray3}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="BtnClose" Grid.Column="2" Style="{StaticResource CaptionCloseButton}"
                            Content="✕" Margin="0,0,14,0" VerticalAlignment="Center" Click="BtnClose_Click" />
                </Grid>

                <!-- ============ 页面容器 ============ -->
                <Grid Grid.Row="1" Margin="20,4,20,0">

                    <!-- - 第 1 页：欢迎 - -->
                    <Grid x:Name="PageWelcome">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                            <!-- 大图标 -->
                            <Border Width="88" Height="88" CornerRadius="22" HorizontalAlignment="Center"
                                    Background="{StaticResource PrimaryGradient}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0b5bcb" BlurRadius="26" ShadowDepth="5" Opacity="0.35" />
                                </Border.Effect>
                                <TextBlock Text="P" Foreground="White" FontSize="46" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="即将安装 PCL-EDIT" FontSize="25" FontWeight="Bold"
                                       Foreground="{StaticResource ColorBrush1}"
                                       HorizontalAlignment="Center" Margin="0,26,0,0" />
                            <TextBlock Text="Plain Craft Launcher 2 的第三方修改版"
                                       FontSize="13.5" Foreground="{StaticResource Gray2}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />

                            <!-- 特性清单 -->
                            <Border CornerRadius="10" Background="White" BorderBrush="{StaticResource Gray6}"
                                    BorderThickness="1" Padding="22,16" Margin="0,26,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Foreground="{StaticResource Success}" FontSize="13"
                                                   FontWeight="Bold" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="恢复游戏本体、Mod 加载器与社区资源的下载"
                                                   FontSize="13" Foreground="{StaticResource Gray1}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Foreground="{StaticResource Success}" FontSize="13"
                                                   FontWeight="Bold" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="已修复上游 25 个开放问题"
                                                   FontSize="13" Foreground="{StaticResource Gray1}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Foreground="{StaticResource Success}" FontSize="13"
                                                   FontWeight="Bold" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="安装完成即可直接启动，无需额外配置"
                                                   FontSize="13" Foreground="{StaticResource Gray1}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- - 第 2 页：选项 - -->
                    <Grid x:Name="PageOptions" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" MaxWidth="560">
                            <TextBlock Text="安装选项" FontSize="21" FontWeight="Bold"
                                       Foreground="{StaticResource ColorBrush1}" Margin="0,0,0,4" />
                            <TextBlock Text="确认后点击「开始安装」，全程自动完成。"
                                       FontSize="13" Foreground="{StaticResource Gray2}" Margin="0,0,0,22" />

                            <!-- 安装位置 -->
                            <TextBlock Text="安装位置" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Gray2}" Margin="2,0,0,8" />
                            <RadioButton x:Name="RadInstallUser" Style="{StaticResource OptionCard}" IsChecked="True"
                                         Checked="InstallLocation_Changed">
                                <StackPanel>
                                    <TextBlock Text="仅为当前用户安装" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource ColorBrush1}" />
                                    <TextBlock x:Name="LabUserPath" FontSize="12" Foreground="{StaticResource Gray3}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RadInstallCustom" Style="{StaticResource OptionCard}"
                                         Checked="InstallLocation_Changed">
                                <StackPanel>
                                    <TextBlock Text="安装到指定文件夹" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource ColorBrush1}" />
                                    <TextBlock x:Name="LabCustomPath" FontSize="12" Foreground="{StaticResource Gray3}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 附加选项 -->
                            <StackPanel Margin="2,14,0,0">
                                <CheckBox x:Name="ChkDesktop" Content="创建桌面快捷方式" IsChecked="True"
                                          FontSize="13" Foreground="{StaticResource Gray1}" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkLaunch" Content="安装完成后立即启动 PCL-EDIT"
                                          IsChecked="True" FontSize="13" Foreground="{StaticResource Gray1}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- - 第 3 页：进度 - -->
                    <Grid x:Name="PageProgress" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" MaxWidth="560">
                            <TextBlock x:Name="LabProgressTitle" Text="正在安装……" FontSize="21" FontWeight="Bold"
                                       Foreground="{StaticResource ColorBrush1}" Margin="0,0,0,6" />
                            <TextBlock x:Name="LabProgressDetail" Text="准备中"
                                       FontSize="13" Foreground="{StaticResource Gray2}" Margin="0,0,0,20" />

                            <ProgressBar x:Name="BarMain" Style="{StaticResource SlimProgress}"
                                         Minimum="0" Maximum="100" Value="0" />

                            <!-- 日志滚动区 -->
                            <Border CornerRadius="10" Background="White" BorderBrush="{StaticResource Gray6}"
                                    BorderThickness="1" Height="150" Margin="0,22,0,0">
                                <ScrollViewer x:Name="ScrollLog" VerticalScrollBarVisibility="Auto" Padding="16,12">
                                    <TextBlock x:Name="LabLog" FontSize="12" Foreground="{StaticResource Gray2}"
                                               LineHeight="20" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- - 第 4 页：完成 - -->
                    <Grid x:Name="PageDone" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                            <Border Width="76" Height="76" CornerRadius="38" HorizontalAlignment="Center"
                                    Background="#e8f8ed">
                                <TextBlock Text="✓" FontSize="38" FontWeight="Bold"
                                           Foreground="{StaticResource Success}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="安装完成" FontSize="25" FontWeight="Bold"
                                       Foreground="{StaticResource ColorBrush1}"
                                       HorizontalAlignment="Center" Margin="0,22,0,0" />
                            <TextBlock x:Name="LabDoneDetail" FontSize="13.5" Foreground="{StaticResource Gray2}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- - 第 5 页：失败 - -->
                    <Grid x:Name="PageFailed" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" MaxWidth="560">
                            <Border Width="76" Height="76" CornerRadius="38" HorizontalAlignment="Center"
                                    Background="#fdecec">
                                <TextBlock Text="!" FontSize="38" FontWeight="Bold"
                                           Foreground="{StaticResource Dangerous}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="安装失败" FontSize="23" FontWeight="Bold"
                                       Foreground="{StaticResource ColorBrush1}"
                                       HorizontalAlignment="Center" Margin="0,20,0,0" />
                            <TextBlock x:Name="LabFailedDetail" FontSize="13" Foreground="{StaticResource Gray2}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <Border CornerRadius="10" Background="White" BorderBrush="{StaticResource Gray6}"
                                    BorderThickness="1" Height="110" Margin="0,20,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                                    <TextBlock x:Name="LabFailedLog" FontSize="11.5" Foreground="{StaticResource Gray3}"
                                               TextWrapping="Wrap" LineHeight="18" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>

                </Grid>

                <!-- ============ 底部按钮栏 ============ -->
                <Border Grid.Row="2" BorderBrush="#eaf1fb" BorderThickness="0,1,0,0" Padding="26,16">
                    <Grid>
                        <TextBlock x:Name="LabFooterHint" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Gray4}"
                                   Text="协议见随附的 LICENCE 文件，上游原文未作改动。" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnBack" Style="{StaticResource TextButton}" Content="上一步"
                                    Margin="0,0,8,0" Visibility="Collapsed" Click="BtnBack_Click" />
                            <Button x:Name="BtnNext" Style="{StaticResource PrimaryButton}" Content="下一步"
                                    Click="BtnNext_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
